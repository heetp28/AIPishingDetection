{
  "manifest_version": 3,
  "name": "CERT-In Anti-Phishing Shield",
  "version": "1.0",
  "description": "AI-powered phishing detection for students",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}